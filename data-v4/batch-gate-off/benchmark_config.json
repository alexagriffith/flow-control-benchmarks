{
  "model_name": "openai/gpt-oss-20b",
  "base_url": "http://<inference-gateway>/<namespace>/<endpoint>",
  "input_tokens_target": 512,
  "output_tokens": 128,
  "prompt_pool_size": 384,
  "sweep_duration_s": 30,
  "scenario_duration_s": 120,
  "drain_timeout_s": 120,
  "repeats": 3,
  "warmup_duration_s": 0,
  "warmup_concurrency": 16,
  "stabilization_repeats": 0,
  "warmup_included_in_summaries": false,
  "traffic_seed": 42,
  "headers": [
    "x-gateway-inference-objective",
    "x-gateway-inference-fairness-id"
  ],
  "objectives": {
    "100": "gpt-oss-premium",
    "0": "gpt-oss-standard",
    "-10": "gpt-oss-batch"
  },
  "flow_control_mode": "off",
  "queue_depth_threshold": "",
  "steady_state_trim_s": 20.0,
  "vllm_prefix_caching_declared": "off",
  "traffic_scale": 1.0,
  "harness_version": "v4",
  "peer_center": 11,
  "a_center": 120,
  "a_amplitude": 20,
  "peer_flat": false,
  "matched_pair_one_band": false,
  "matched_pair_two_band": false
}