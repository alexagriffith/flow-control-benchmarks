    "production_repeats": 3
  },
  "metrics": {
    "captured_during_every_run": true,
    "direct_and_prometheus": true
  },
  "runner": {
    "scenario_source": "pipeline/benchmark.py",
    "sha256": "3811ec26c46bf3a26fa643698ec54bf569bb4bc99c3ea22ca18f805cb077b8e0",
