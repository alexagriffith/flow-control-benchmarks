{
  "topology": {
    "endpoint_picker_replicas": 1,
    "model_replicas": 1,
    "gpus_per_model_replica": 1
  },
  "endpoint_picker": {
    "image": "ghcr.io/llm-d/llm-d-router-endpoint-picker:v0.9.0",
    "selected_detector": "request-count admission",
    "max_concurrency": 128,
    "headroom_by_scenario": {
      "priority tiers": 0.1,
      "batch isolation": 0.15,
      "consolidation": 0.1,
      "same-priority fairness": 0.1
    },
    "comparison_detectors": [
      "utilization queue depth 2",
      "utilization queue depth 5"
    ]
  },
  "model_service": {
    "image": "registry.redhat.io/rhaii/vllm-cuda-rhel9@sha256:ad06abf3bb5235ebb5b2df84cd1b9fd09e823f0ff2eebfc82bb4590275ccfe0b",
